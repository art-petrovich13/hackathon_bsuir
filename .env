# .env — секретные переменные, НЕ коммитить в Git!

# PostgreSQL
POSTGRES_DB=npa_db
POSTGRES_USER=npa_user
POSTGRES_PASSWORD=npa_pass

# SQLAlchemy URL (внутри Docker сети хост = "postgres", не localhost)
DATABASE_URL=postgresql+asyncpg://npa_user:npa_pass@postgres:5432/npa_db

# Redis (внутри Docker сети хост = "redis")
REDIS_URL=redis://redis:6379/0

