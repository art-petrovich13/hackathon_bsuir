# .env.example — скопируй в .env и заполни реальными значениями

POSTGRES_DB=npa_db
POSTGRES_USER=npa_user
POSTGRES_PASSWORD=npa_pass
DATABASE_URL=postgresql+asyncpg://npa_user:npa_pass@postgres:5432/npa_db
REDIS_URL=redis://redis:6379/0
GEMINI_API_KEY=получи_на_aistudio.google.com_бесплатно
SECRET_KEY=change_me_to_random_string
DEBUG=true